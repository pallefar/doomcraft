    "levelIndex": 5,
    "author": "Doomcraft",
    "description": "One room, four cages, two lava trenches and a keycard on a dais in the middle of all of it. There is no corridor to retreat into here. Throw a gauntlet switch and something comes out of a wall.",
    "parTimeSec": 250,
    "musicCue": "e1m5",
    "outsideBlock": "bedrock",
    "defaultSkill": 2,
